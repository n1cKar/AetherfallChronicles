    "react-dom": "^19.2.7",
    "three": "^0.172.0",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@types/three": "^0.172.0",
    "concurrently": "^9.2.1",
    "typescript": "^5.7.3",
    "vite": "^6.0.7"
  }
