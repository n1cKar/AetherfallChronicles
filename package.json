  "description": "Aetherfall Chronicles - voxel-inspired browser dungeon-crawling action RPG. Developed by n1ckar",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n web,server -c cyan,magenta \"vite\" \"node server/gameServer.mjs\"",
